# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/enkai_business?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-better-auth-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="Your Business Name"
SMTP_ENCRYPTION="tls"

# ImageKit
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your-public-key"
IMAGEKIT_PRIVATE_KEY="your-private-key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-endpoint"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Enkai Business"

# AI / LLM (Firdaus AI OS)
# Provider: "openai" | "anthropic" | "gemini"
AI_PROVIDER="openai"
# Get your API key from the provider's dashboard
AI_API_KEY="sk-your-api-key-here"
# Model name (provider-dependent):
#   OpenAI: "gpt-4o", "gpt-4o-mini", "gpt-4-turbo"
#   Anthropic: "claude-3-5-sonnet-20241022", "claude-3-haiku-20240307"
#   Gemini: "gemini-2.0-flash-exp", "gemini-1.5-pro"
AI_MODEL="gpt-4o"
